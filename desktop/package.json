{
  "name": "bader-wallstudio",
  "productName": "Bader Wallstudio",
  "version": "1.0.0",
  "description": "Bader Wallstudio – Wand- und Bodengestaltung",
  "author": "Bader Wallstudio",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "ch.baderdesign.wallstudio",
    "productName": "Bader Wallstudio",
    "files": ["main.js"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Bader-Wallstudio-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Bader Wallstudio",
      "uninstallDisplayName": "Bader Wallstudio",
      "deleteAppDataOnUninstall": false
    }
  }
}
